{
  "name": "crmcts-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cold Room Management & Construction Tracking System - API server",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test:api": "tsx src/__tests__/apiKey.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "backfill:sprint": "tsx prisma/backfillSprint.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dxf": "^5.3.1",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.0.227",
    "pdfkit": "^0.15.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
