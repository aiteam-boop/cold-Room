// CRMCTS — Prisma schema. MongoDB (Atlas) backed. String cuid ids are mapped to
// Mongo's `_id` so application code keeps treating ids as opaque strings.
// (Was SQLite; switched to MongoDB. relationMode is "prisma" implicitly on Mongo.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Users & Access ─────────────────────────────────────────────────────────
// Note: allowed enum-like values are enforced in app code
// (see server/src/lib/enums.ts). Role: ADMIN | ENGINEER | SUPERVISOR | CLIENT | MANAGEMENT

model User {
  id           String           @id @default(cuid()) @map("_id")
  name         String
  email        String           @unique
  passwordHash String
  // Global account role: ADMIN (full access) | USER (grant-based). See enums.ts.
  role         String           @default("USER")
  active       Boolean          @default(true)
  employeeCode String?          // company employee ID/code — lets external systems match a person
  whatsapp     String?          // optional, for parity with IMS (no alerting yet)
  // IMS-style per-user grants (admin-controlled). JSON, parsed in permissions.ts.
  pageAccess   String?          // { [pageKey]: { view: bool, edit: bool } }
  sectionPerms String?          // { hideFinancials, canApprove, canMarkPaid }
  // Approver registry profile (JSON): { canApprove, approvalRole, level, types[] }.
  // Designates this user as a selectable approver for approval chains.
  approver     String?
  twoFactor    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  // Stamped on every successful login, so the Users admin can show who is
  // actually using the system. Backfilled from the USER_LOGIN audit trail.
  lastLoginAt  DateTime?
  // Stamped when the user explicitly logs out (attendance / last-seen).
  lastLogoutAt DateTime?

  memberships  ProjectMember[]
  submitted    ProgressEntry[]  @relation("SubmittedBy")
  approvals    ProgressEntry[]  @relation("ApprovedBy")
  drawings     Drawing[]
  auditLogs    AuditLog[]
  projects     Project[]        @relation("CreatedProjects")
  notifications Notification[]
}

// Many-to-many between users and projects, carrying a per-project role.
model ProjectMember {
  id        String   @id @default(cuid()) @map("_id")
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ── Projects ───────────────────────────────────────────────────────────────
// status: DRAFT | ACTIVE | ON_HOLD | COMPLETED

model Project {
  id                   String          @id @default(cuid()) @map("_id")
  name                 String
  clientName           String?
  siteLocation         String?
  // The client's PO number this project/delivery is booked against — printed on the
  // packing list (Amisha interview 64). A client may have several; editable.
  clientPoNumber       String?
  startDate            DateTime?
  targetCompletionDate DateTime?
  status               String          @default("DRAFT")
  boqLocked            Boolean         @default(false)
  // Test/sandbox project — hidden from everyone except the super-admin.
  testOnly             Boolean         @default(false)
  boqLockedAt          DateTime?
  createdById          String
  createdBy            User            @relation("CreatedProjects", fields: [createdById], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // ── Frozen budget (BOQ & Budget PRD v1 §3) ──────────────────────────────────
  // The internal costing that the bid was built on. Once FROZEN it is the
  // benchmark every PO is measured against and nobody may edit it — the only way
  // it changes afterwards is a Change Order adding scope.
  budgetStatus         String          @default("DRAFT")  // DRAFT | FROZEN
  budgetContingencyPct Float?          // e.g. 5 — added on top of the line total
  budgetFrozenAt       DateTime?
  budgetFrozenById     String?

  boqAnalyzedAt        DateTime?

  // ── Project start-date anchor (Sprint PRD §2) ──
  // The project "officially starts" only when EVERY drawing approval is ticked.
  // Order receipt and advance payment are recorded but do not start the clock.
  orderReceiveDate     DateTime?   // order / LOI received from the client
  advanceReceiveDate   DateTime?   // advance payment landed in the company account
  officialStartDate    DateTime?   // = max(actualDate) over drawingApprovals; null until all approved
  drawingApprovals     Json?       // DrawingApproval[] — see services/drawingApprovals.ts

  members   ProjectMember[]
  boqItems  BOQItem[]
  budgetLines BOQBudgetLine[]
  quotations  VendorQuotation[]
  boqAnalysis BOQAnalysisItem[]
  drawings  Drawing[]
  zones     ProjectZone[]
  entries   ProgressEntry[]
  auditLogs AuditLog[]

  // Room-wise DPR (replaces DPR_Cold_Storage_RoomWise.xlsx)
  scopeItems  RoomScopeItem[]
  dprEntries  DPREntry[]
  milestones  ProjectMilestone[]

  // Module C — Procurement
  vendorSites   VendorSiteMapping[]
  procurementDocs ProcurementDoc[]
  grns          GRN[]
  goodsReceipts GoodsReceipt[]
  procDocuments ProcurementDocument[]
  ganttActivities GanttActivity[]
  changeOrders  ChangeOrder[]
  vendorPayments VendorPayment[]
  boqCostNotes  BOQCostAnnotation[]
}

// ── Module C: Procurement & PO Management ───────────────────────────────────

// Vendor / Contractor master (KYC stored once, site-wise mapped).
// type: VENDOR | CONTRACTOR
//
// The legacy single-contact / single-bank columns below are kept as the
// denormalized "primary" values (POs snapshot them, and old records still
// populate only these). The Sprint PRD §5 profile lives in the Json columns:
// contacts[], plants[], bankAccounts[], rateChart[] — each a superset of the
// legacy field it replaces. Writers keep both in sync (see routes/vendors.ts).
model Vendor {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  type          String   @default("VENDOR")
  contactPerson String?
  phones        String?  // comma/JSON list
  tel           String?
  fax           String?
  website       String?
  address       String?
  email         String?
  gstin         String?  // GSTN.NO
  cin           String?
  pan           String?
  bankAccount   String?
  ifsc          String?
  createdById   String?
  createdAt     DateTime @default(now())

  // ── Full vendor profile (Sprint PRD §5) ──
  legalName       String?   // full registered name, e.g. "Kingspan Jindal Pvt. Ltd."
  tradeName       String?   // brand, if it differs from the legal name
  vendorType      String?   // MANUFACTURER | TRADER | CONTRACTOR | SERVICE_PROVIDER
  boqCategories   String[] @default([])  // which BOQ categories this vendor supplies
  workCategories  String[] @default([])  // contractors only: which work types they do
  contacts        Json?     // [{ id, name, designation, authorityLevel, phones[], email, isPrimary }] — max 10
  plants          Json?     // [{ id, address, address2, city, state, pin, gstin }]
  billingAddress  Json?     // { address, city, state, pin } — used on the PO "Invoice To"
  bankAccounts    Json?     // [{ id, bankName, branch, ifsc, accountNo, accountType, beneficiaryName, isPrimary }]
  rateChart       Json?     // [{ id, itemDescription, unit, rate, effectiveFrom, effectiveTo, notes }]
  registeredSince DateTime?
  isActive        Boolean  @default(true)  // inactive vendors are hidden from PO/WO search

  siteMappings  VendorSiteMapping[]
  docs          ProcurementDoc[]
  kycDocs       ProcurementDocument[]
  itemLists     BOQItemList[]
  payments      VendorPayment[]
  quotations    VendorQuotation[]
}

model VendorSiteMapping {
  id        String  @id @default(cuid()) @map("_id")
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([vendorId, projectId])
}

// Purchase Order / Work Order. type: PO | WO
// status: DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
model ProcurementDoc {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String   // PO | WO
  docNumber     String   @unique
  status        String   @default("DRAFT")

  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  // Snapshot of vendor header (auto-filled, manually overridable)
  vendorName    String?
  vendorAddress String?
  vendorGstin   String?
  vendorContact String?
  vendorPhone   String?

  docDate       DateTime @default(now())
  againstQuotation String?
  invoiceTo     String?  // fixed company billing block (editable)
  shipTo        String?  // PO ship-to
  siteAddress   String?  // WO site address

  // ── Delivery commitment (DPR PRD §3.2 G7 / transcript R12) ──
  // "Delivery date ka ek time aayega. Kab delivery karna hai usko maal ko?"
  // `promisedDeliveryDate` is what the vendor committed on the PO; `requiredByDate`
  // is what site needs. The ACTUAL delivery date is never stored — it is derived
  // as MIN(grnDate) over this doc's APPROVED GRNs, so it can never drift.
  promisedDeliveryDate DateTime?
  requiredByDate       DateTime?

  // Totals
  basicAmount   Float    @default(0)
  gstEnabled    Boolean  @default(true)
  gstPct        Float    @default(18)
  gstAmount     Float    @default(0)
  finalAmount   Float    @default(0)
  overrides     String?  // JSON: which fields were manually overridden

  // 6-field payment terms (% values); amounts derived/overridable
  payAdvancePct        Float @default(0)
  payBeforeDeliveryPct Float @default(0)
  payRunningPct        Float @default(0)
  payPostDeliveryPct   Float @default(0)
  payPostCompletionPct Float @default(0)
  payRetentionPct      Float @default(0)
  // true → milestone ₹ = % of the FINAL amount (incl. GST); false → % of the BASIC.
  payGstInclusive      Boolean @default(false)
  payTriggers          String? // JSON: per-field trigger condition notes + INR overrides

  // JSON array of T&C clauses. Each: { title, text, isStruckOff?, struckOffAt?,
  // isLocked?, isCustom? }. Struck-off clauses stay in the document (rendered
  // with a strikethrough) — they are never deleted. See services/procurement.ts.
  // User-added item columns: JSON [{ key, label }]. Values live per line item.
  customColumns String?
  termsSections String?

  // BOQ items this PO is compared against on its "Budget vs Actual" panel
  // (BOQ & Budget PRD §5). Persisted so the comparison survives navigating away.
  // JSON array of BOQ item ids. Line-linked items appear automatically; these are
  // the extra ones the user picked to compare.
  budgetCompareItemIds String?

  // Per-payment-term Proforma Invoices uploaded on the PO, so the approver sees
  // each term's PI and a GRN raised for that term auto-fetches it. JSON keyed by
  // the term key (advance | beforeDelivery | running | postDelivery |
  // postCompletion | retention): { [termKey]: { piNumber, piDate, piValue, piPdfUrl } }.
  termPis String?
  // UTR(s) fetched from the external Accounts/FMS sheet for POs paid via the
  // Accounts FORM before the in-app payment flow existed (Procurement §A · FMS
  // backfill). JSON array: [{ utr, vrNo, amount, invoice, matchedBy, fetchedAt }].
  // Read-only mirror of the sheet — shown in the pipeline, never used to compute
  // in-app payment status. See services/fmsUtr.ts + [[fms-utr-sheet]] memory.
  sheetPayments String?

  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  rejectionReason String?
  esignApplied  Boolean  @default(false)
  lockedAt      DateTime?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Post-approval amendment log. An approved PO/WO is locked, but real orders do
  // get changed after signing — so an edit is allowed IF a reason is given, and
  // every such edit is recorded here (who, their email, when, why) and shown to
  // everyone on the document. JSON array of
  // { at, byId, byName, byEmail, remark }. See routes/procurement.ts.
  amendments    String?

  lineItems     ProcurementLineItem[]
  milestones    PaymentMilestone[]
  grns          GRN[]
  goodsReceipts GoodsReceipt[]
  vendorPayments VendorPayment[]

  @@index([projectId])
  @@index([type])
}

// ── FMS: Vendor Payment Entry (Procurement/Finance Flow PRD v2 §4) ───────────
// Amisha records a payment to a vendor against a PO. The balance and the
// PO's payment-terms % are computed/fetched (no phone calculator). The finance
// approval chain (Supriya → Shivani → Alok → Tarakant → Sir, configurable) runs
// through the shared ApprovalStep engine with docType = 'PAYMENT'.
model VendorPayment {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentNumber String   @unique          // FMS-0001

  filledById    String                     // who is filling (auto)
  department    String?  @default("Cold Room")

  // Performa Invoice (NOT a tax-invoice number)
  piNumber      String?
  piDate        DateTime?

  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  vendorName    String?

  // The PO this payment is against. Its PDF is the attachment (no ledger).
  docId         String?
  doc           ProcurementDoc? @relation(fields: [docId], references: [id])
  poNumber      String?

  // Which of the PO's payment terms (milestones) this pays — picked from a
  // dropdown of the PO's actual terms; already-paid ones are not selectable.
  // (GRN/Payment PRD v3 §3.2.) Approving/paying this entry reflects onto the
  // milestone so the Payment Pipeline & BOQ Cost stay in step.
  milestoneId   String?
  milestoneKey  String?   // advance | beforeDelivery | running | postDelivery | postCompletion | retention
  milestoneName String?

  // Amounts — full & amount-to-pay are MANUAL (billing is per actual qty +
  // freight); balance is derived = full − paidSoFar.
  paymentType   String   @default("ADVANCE")  // ADVANCE | BALANCE | FULL
  fullAmount    Float    @default(0)
  amountToPay   Float    @default(0)
  balance       Float    @default(0)
  // GST toggle: when true the amount is treated as 100% GST-inclusive.
  gstInclusive  Boolean  @default(false)
  gstPct        Float    @default(18)
  // Snapshot of the PO's payment-terms % at the time of entry (advance/before/
  // running/postDelivery/postCompletion/retention), fetched on PO select.
  payTermsSnapshot String?

  // Attachments
  piPdfUrl      String?                    // proforma invoice PDF — drives the payment, comes first
  taxInvoicePdfUrl String?                 // tax invoice — arrives later; uploading it CLOSES the entry
  kycPdfUrl     String?                    // vendor KYC PDF (GST+PAN+cheque)

  remark        String?                    // what the payment is regarding

  // Lifecycle (GRN/Payment PRD v3 §6). A payment can be PAID but still open —
  // it only CLOSES once the vendor's tax invoice is uploaded.
  // status: DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | PAID | CLOSED
  status        String   @default("DRAFT")
  approvedById  String?
  approvedAt    DateTime?
  rejectionReason String?
  paidAt        DateTime?
  paymentReference String?                 // UTR when marked paid
  closedAt      DateTime?                  // set when the tax invoice is uploaded
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([docId])
}

// ── BOQ & Cost editable overlay (PRD v2 §5) ─────────────────────────────────
// The finance team edits a few actuals per (BOQ item × PO) directly on the cost
// sheet, layered over the derived numbers: ordered qty (actual differs from PO),
// overall PO amount (freight added later), the planned delivery per the Gantt,
// the actual delivery date, and a "client invoicing done" tick. Kept separate so
// the PO (the contract) is never mutated by cost-sheet edits — user decision:
// "for now do the editable" as an overlay.
model BOQCostAnnotation {
  id                String   @id @default(cuid()) @map("_id")
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId         String
  // Optional PO scope — an annotation may pin to a specific PO for the row, or
  // be the row-level override when there is a single PO.
  docId             String?

  orderedQtyOverride   Float?     // actual quantity ordered till now
  poAmountOverride     Float?     // overall PO amount incl. freight etc.
  rateOverride         Float?     // rate used for qty × rate (else PO unit price)
  plannedDeliveryDate  DateTime?  // as per the Gantt / dispatch plan
  actualDeliveryDate   DateTime?  // when it actually arrived
  invoicingDone        Boolean  @default(false)  // finance ticked: client invoice raised
  invoicingDoneById    String?
  invoicingDoneAt      DateTime?
  remarks              String?

  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, boqItemId])
  @@index([projectId])
}

// BOQ-vs-Received reconciliation remark LOG (Procurement PRD §8 · G2). Unlike the
// single `remarks` on BOQCostAnnotation, this is APPEND-ONLY: each note about a
// reconciliation row (a shortfall, a follow-up) is a new row, so the issue is
// tracked over time and never overwritten. No Prisma relations — purely additive.
model BOQReconRemark {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  boqItemId     String
  text          String
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([projectId, boqItemId])
}

model ProcurementLineItem {
  id          String  @id @default(cuid()) @map("_id")
  docId       String
  doc         ProcurementDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  srNo        Int
  description String          // size/description (multi-line)
  uom         String?         // WO only
  qty         Float   @default(0)
  unitPrice   Float   @default(0)
  totalPrice  Float   @default(0)
  // Some lines are not taxable (e.g. a refundable security deposit). When true,
  // this line's value is EXCLUDED from the GST base but still counts in the
  // Basic/Final amount. Default false → GST applies, preserving old behaviour.
  gstExempt   Boolean @default(false)
  gstExemptRemark String? // why this line is GST-exempt, e.g. "refundable deposit"
  // Per-line GST rate (%). Null → use the document's default gstPct. Lets each
  // spare carry its own rate (one line 5%, another 18%). Ignored when gstExempt.
  gstPct      Float?
  isLeadTime  Boolean @default(false) // special "Lead Time: 7 Days" row
  leadTimeText String?
  customValues String? // JSON { [colKey]: value } for the doc's user-added columns
  sortOrder   Int     @default(0)

  // Back-link to the BOQ line this item fulfils. Drives the BOQ Cost view:
  // one BOQ item may be covered by several POs. Null = "unlinked PO line".
  boqItemId   String?
  boqItem     BOQItem? @relation(fields: [boqItemId], references: [id])

  // BOQ head (heading/category) this line rolls up under — Procurement PRD §5 (D2).
  // INTERNAL ONLY: mandatory to issue a PO, never printed on the vendor PDF. The
  // linked boqItem (above) is the finer "sub-item"; the head is the coarse bucket
  // (e.g. "Refrigeration Units"). "Other" is a valid value when the exact head
  // isn't known. Null = legacy line issued before head-mapping existed (fixed via
  // the Head Mapping view, D3).
  boqHead     String?

  grnLines    GRNLineItem[]

  @@index([docId])
  @@index([boqItemId])
}

// Auto-generated from 6-field payment terms (one per non-zero field).
// status: PENDING | TRIGGERED | PAID
model PaymentMilestone {
  id            String  @id @default(cuid()) @map("_id")
  docId         String
  doc           ProcurementDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  fieldKey      String          // advance | beforeDelivery | running | postDelivery | postCompletion | retention
  name          String
  triggerCondition String?
  percentage    Float   @default(0)
  inrAmount     Float   @default(0)
  // Cumulative amount actually paid against this term. A term can be paid in
  // parts (Amisha PRD A1/A3): status becomes PARTIALLY_PAID until amountPaid
  // reaches inrAmount, then PAID. Legacy PAID rows carry 0 here — readers fall
  // back to inrAmount via milestonePaidAmount(), so no backfill is needed.
  amountPaid    Float   @default(0)
  expectedDate  DateTime?
  actualTriggerDate DateTime?
  status        String  @default("PENDING")  // PENDING | TRIGGERED | PARTIALLY_PAID | PAID
  accountsNotifiedAt DateTime?
  paymentDate   DateTime?
  paymentReference String?
  // UTR captured by Accounts on "Mark as Paid". Manual today; FMS auto-fetch is
  // a Phase-2 item (Sprint PRD §9). For part-payments this holds the LATEST UTR;
  // the full history lives in `installments`.
  utrNumber       String?
  paymentProofUrl String?   // NEFT receipt / bank transfer screenshot
  remarks       String?
  sortOrder     Int     @default(0)
  installments  PaymentInstallment[]

  @@index([docId])
}

// One part-payment against a milestone (Amisha PRD A1/A3). Each partial release
// keeps its own amount + UTR + date, so the payment history is auditable even
// when a term is settled over several transfers.
model PaymentInstallment {
  id            String  @id @default(cuid()) @map("_id")
  milestoneId   String
  milestone     PaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  docId         String
  amount        Float   @default(0)
  utrNumber     String?
  paymentReference String?
  paymentDate   DateTime?
  paymentProofUrl String?
  remarks       String?
  paidById      String?
  createdAt     DateTime @default(now())

  @@index([milestoneId])
  @@index([docId])
}

// Good Receipt Note. status: DRAFT | OPEN | APPROVED | REJECTED
model GRN {
  id          String  @id @default(cuid()) @map("_id")
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docId       String  // parent PO/WO
  doc         ProcurementDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  grnNumber   String  @unique
  grnDate     DateTime @default(now())
  vendorName  String?
  siteAddress String?
  raisedById  String?
  vehicleNumber String?
  driverName  String?
  deliveryChallanNumber String?

  // ── Payment (GRN/Payment PRD v3 §3) — Amisha does the payment on the GRN. ──
  // Which of the PO's payment terms (milestones) this GRN pays; already-paid
  // ones are not selectable. Approving the GRN triggers the milestone.
  milestoneId   String?
  milestoneKey  String?
  milestoneName String?
  // Proforma Invoice — drives the payment and comes BEFORE the tax invoice.
  piNumber      String?
  piDate        DateTime?
  // When Accounts must pay by — feeds "Payment Due Date" on the FMS sheet.
  paymentDueDate DateTime?
  piValue       Float?
  piPdfUrl      String?
  // The amount to release for this milestone (editable; may be partial). Balance
  // is derived = piValue − advance already paid on the PO − amountToPay.
  amountToPay   Float?

  // ── Payment lifecycle (GRN/Payment PRD v3 §6) ──
  // Runs alongside `status` (goods/approval state), NOT on it. Ladder:
  // approved → TRIGGERED (milestone triggered on approval) → PAID (Accounts enter
  // the UTR) → CLOSED (the tax invoice is finally uploaded). A GRN can be PAID but
  // still open — the entry only leaves Amisha's bucket once the tax invoice lands.
  paymentStatus   String?   // TRIGGERED | PAID | CLOSED
  utrNumber       String?
  paidAt          DateTime?
  paymentProofUrl String?
  paymentClosedAt DateTime?

  // Payment-release sign-off from the FMS sheet's "Approval Form" link. A no-login
  // page (keyed by releaseToken) lets management mark the payment APPROVED or
  // ON_HOLD; the decision shows next to the payment status in the app + the sheet.
  // It runs ALONGSIDE paymentStatus (Triggered/Paid) — it does not change it.
  releaseToken   String?
  releaseStatus  String?   // APPROVED | ON_HOLD (null = not decided)
  releaseAt      DateTime?
  releaseBy      String?
  releaseRemark  String?

  // Invoice-approval sign-off — a SEPARATE chain (ApprovalStep docType 'INVOICE')
  // that mirrors the payment release: once the tax invoice is uploaded, "Submit
  // Invoice for Approval" mails the SAME payment approvers a no-login page to
  // Approve / Hold the invoice. Runs alongside the payment release; the invoice
  // page also shows the payment's approval status + UTR for reference.
  invoiceReleaseToken   String?
  invoiceReleaseStatus  String?   // APPROVED | ON_HOLD (null = not decided)
  invoiceReleaseAt      DateTime?
  invoiceReleaseBy      String?
  invoiceReleaseRemark  String?

  // Tax-invoice section (arrives later; closes the payment side).
  invoiceNumber String?
  invoiceDate   DateTime?
  invoiceValue  Float?
  invoicePdfUrl String?
  ewayBillNumber String?
  packingListUrl String?
  photoUrl      String?   // optional photo of the received material

  status        String  @default("DRAFT")
  approvedById  String?
  approvedAt    DateTime?
  rejectionReason String?
  pdfUrl        String?
  createdAt     DateTime @default(now())

  // Post-approval amendment log (see ProcurementDoc.amendments). JSON array of
  // { at, byId, byName, byEmail, remark }.
  amendments    String?

  lineItems   GRNLineItem[]

  @@index([projectId])
  @@index([docId])
  @@index([releaseToken])
}

model GRNLineItem {
  id            String  @id @default(cuid()) @map("_id")
  grnId         String
  grn           GRN     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  lineItemId    String?
  lineItem      ProcurementLineItem? @relation(fields: [lineItemId], references: [id])
  srNo          Int
  description   String
  uom           String?
  poQty         Float   @default(0)
  previouslyReceivedQty Float @default(0)
  receiptQty    Float   @default(0)
  defectQty     Float   @default(0)
  acceptedQty   Float   @default(0)
  remarks       String?

  @@index([grnId])
}

// ── Goods Receipt (physical delivery at site) ──────────────────────────────
// A GRN in the literal sense: material/spares/machines arriving on site against
// an approved PO/WO. This is deliberately SEPARATE from the payment record (the
// old "GRN", now surfaced as "Payment"): a goods receipt only captures the
// delivery (vehicle/driver/challan) and what was actually received per line —
// no PI, no milestone, no payment lifecycle. Numbered GRN-QAS-###.
model GoodsReceipt {
  id          String  @id @default(cuid()) @map("_id")
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docId       String  // parent PO/WO the material is received against
  doc         ProcurementDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  grnNumber   String  @unique
  receivedDate DateTime @default(now())
  vendorName  String?
  siteAddress String?
  raisedById  String?
  vehicleNumber String?
  vehicleSize String?   // e.g. "40 FT" — shown on the packing list
  driverName  String?
  deliveryChallanNumber String?
  // Packing-list / delivery fields (Amisha interview 63/64). dispatchDate doubles
  // as the invoice date ("Date of Invoice / Date of Dispatch"); deliveryDate is
  // the date material reached site.
  invoiceNumber String?
  dispatchDate  DateTime?
  deliveryDate  DateTime?
  ewayBillNumber String?
  // Mode 1 = direct PO→GRN (received qty against PO lines). Mode 2 = custom packing
  // list Amisha builds (own sizes/columns), then the site engineer fills received qty.
  mode        String  @default("DIRECT")  // DIRECT | CUSTOM
  // For Mode 2 — the configurable extra columns (JSON: [{ key, label }]).
  customColumns String?
  // Site-engineer share link: whom it was assigned to + the token that unlocks the
  // no-login public GRN form.
  siteEngineerEmail String?
  linkToken   String?
  packingListNo Int?
  // Site supervisor name typed by whoever fills the GRN form on site — printed on
  // the packing list's "Site Supervisor:" line (blank prints a blank line).
  siteSupervisor String?
  photoUrl    String?
  remarks     String?
  status      String  @default("DRAFT")  // DRAFT | RECEIVED
  // Phase 4 (signed packing-list upload + reminders + billing confirm):
  // when the site engineer submitted the filled form; drives the daily
  // "signed packing list still pending" reminder throttle.
  submittedAt DateTime?
  lastReminderAt DateTime?
  // Billing confirms "material received" once a signed copy is uploaded — this
  // closes the GRN and feeds the payment pipeline.
  billingConfirmedAt DateTime?
  billingConfirmedById String?
  createdAt   DateTime @default(now())
  lineItems   GoodsReceiptLine[]

  @@index([projectId])
  @@index([docId])
  @@index([linkToken])
}

model GoodsReceiptLine {
  id            String  @id @default(cuid()) @map("_id")
  grId          String
  gr            GoodsReceipt @relation(fields: [grId], references: [id], onDelete: Cascade)
  lineItemId    String?
  srNo          Int
  description   String
  uom           String?
  poQty         Float   @default(0)
  previouslyReceivedQty Float @default(0)
  receiptQty    Float   @default(0)
  defectQty     Float   @default(0)
  acceptedQty   Float   @default(0)
  remarks       String?
  // Per-item delivery photo (Procurement PRD §3 · B5). Moves the GRN from one
  // material photo to a photo PER LINE — the proof that this specific item arrived.
  // Captured on the mobile site-engineer form (camera or gallery). /uploads/<file>.
  photoUrl      String?
  // Mode 2 (custom packing list) — values for the GR's configurable columns
  // (JSON keyed by column key, e.g. { panelType, width, length, sqmtr, bundleNo }).
  customValues  String?

  @@index([grId])
}

// Central document repository entry.
// type: PO | WO | GRN | PI | KACCHA_BILL | TAX_INVOICE | DELIVERY_CHALLAN |
//       KYC | COMPLETION_CERT | PHOTO | EWAY | PAYMENT_PROOF | PACKING_LIST | OTHER
model ProcurementDocument {
  id            String  @id @default(cuid()) @map("_id")
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String
  // Which KYC document this is, when type = 'KYC'. Drives the vendor's KYC
  // status badge (COMPLETE needs GST + PAN + cancelled cheque). Null on legacy
  // rows uploaded before the kind was captured. See lib/enums.ts KYC_KINDS.
  kycKind       String?
  fileName      String
  fileUrl       String
  mimeType      String?
  linkedDocNumber String?
  vendorId      String?
  vendor        Vendor? @relation(fields: [vendorId], references: [id])
  vendorName    String?
  uploadedById  String?
  uploadedAt    DateTime @default(now())
  archived      Boolean @default(false)
  archiveReason String?

  @@index([projectId])
  @@index([type])
}

// AI-processed, clean procurement breakdown of the raw BOQ (the "bible").
// Generated from BOQItem rows; the raw BOQItem table is left untouched.
model BOQAnalysisItem {
  id             String   @id @default(cuid()) @map("_id")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  srNo           String?
  itemName       String              // short, clean name
  category       String?
  quantity       Float?
  unit           String?
  specifications String?             // key technical specs (concise, ; separated)
  requirements   String?             // what must be supplied/approved
  dependencies   String?             // coordination / depends-on
  notes          String?             // important caveats
  boqItemId      String?             // best-effort link back to the raw line
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([projectId])
}

// ── BOQ ──────────────────────────────────────────────────────────────────────

model BOQItem {
  id          String   @id @default(cuid()) @map("_id")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  srNo        String?
  description String
  category    String?        // e.g. "Refrigeration Units", "PUF Panels"
  roomZone    String?        // e.g. "Blast Freezer (-30C)"
  unit        String?        // mtr, No's, Sq.M, RMT, MT
  makeModel   String?        // "Make & Model" column from the BOQ sheet (brand/spec)
  remarks     String?        // "Remarks" column from the BOQ sheet (specs/notes)
  plannedQty  Float          @default(0)

  // The machine model number chosen for this line (Machine-Model/TDS PRD §5).
  // NOT part of the BOQ — it is decided later and is vendor-specific, so it is a
  // typed field, editable even after the BOQ is locked.
  modelNumber String?

  // ── BOQ Enhancements (Gantt/Room PRD) — all additive, optional ──
  itemCategory     String?    // EQUIPMENT | MATERIAL | SERVICE (drives Make&Model UI)
  machineModelId   String?
  machineModel     MachineModel? @relation(fields: [machineModelId], references: [id])
  makeModelRawText String?    // original model text from BOQ before matching to master
  makeModelStatus  String?    // CONFIRMED | PARTIAL | MISSING | NOT_APPLICABLE
  displaySequence  Int?       // numeric BOQ-document order (for dashboard sort fix)

  // Hierarchy (collapsible BOQ tree)
  parentId    String?
  parent      BOQItem?       @relation("BOQHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    BOQItem[]      @relation("BOQHierarchy")
  isGroup     Boolean        @default(false) // header row with no own quantity
  sortOrder   Int            @default(0)

  // Link to a spatial zone
  zoneId      String?
  zone        ProjectZone?   @relation(fields: [zoneId], references: [id])

  lockedAt    DateTime?
  createdAt   DateTime       @default(now())

  entries     ProgressEntry[]
  itemLists       BOQItemList[]
  ganttActivities GanttActivity[]
  changeOrders    ChangeOrder[]
  // PO/WO lines that fulfil this BOQ item — the cost side of the BOQ Cost view.
  poLineItems     ProcurementLineItem[]
  // Room-wise breakup of this line's plannedQty (DPR).
  scopeItems      RoomScopeItem[]
  // The frozen internal costing for this line — what we said it would cost.
  budgetLine      BOQBudgetLine?
  // Vendor quotations collected for this line, and the awarded one (PRD §4).
  quotations      VendorQuotation[]

  // ── Award (BOQ & Budget PRD v1 §4) ──
  // The quotation chosen for this item, and WHY. The reason is mandatory when the
  // pick is not the lowest (L1) — see routes/quotations.ts.
  awardedQuotationId String?
  awardReason        String?
  awardedById        String?
  awardedAt          DateTime?

  @@index([projectId])
  @@index([parentId])
}

// ── Progress ─────────────────────────────────────────────────────────────────
// status: PENDING | APPROVED | REJECTED | VOIDED

model ProgressEntry {
  id               String      @id @default(cuid()) @map("_id")
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId        String
  boqItem          BOQItem     @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  submittedById    String
  submittedBy      User        @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvedById     String?
  approvedBy       User?       @relation("ApprovedBy", fields: [approvedById], references: [id])

  date             DateTime
  quantityInstalled Float
  unit             String?
  photoUrl         String?
  remarks          String?

  status           String      @default("PENDING")
  approvedAt       DateTime?
  rejectionReason  String?
  voidReason       String?
  createdAt        DateTime    @default(now())

  @@index([projectId])
  @@index([boqItemId])
  @@index([status])
}

// ── Drawings & Zones ─────────────────────────────────────────────────────────
// status: PROCESSING | APPROVED | ARCHIVED

// A drawing, and — through `parentId` — every revision of it.
//
// AA sir (transcript P11): "ye base drawing hai, then revision, revision,
// revision, final drawing. Jo final drawing hota hai usi ke base pe ye saare
// calculation honge."
//
// So a drawing family is a chain: the root (version 1) holds the base upload and
// each later revision points at the root via `parentId`. Exactly one drawing in a
// family may be `isFinal` — that is the approved drawing every room-wise target
// quantity is derived from. `discipline` says which of the four approval
// checklist rows this family satisfies.
model Drawing {
  id             String         @id @default(cuid()) @map("_id")
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  mimeType       String?
  fileSize       Int?
  uploadedById   String
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  version        Int            @default(1)
  status         String         @default("PROCESSING")
  extractedZones String?        // JSON array of AI/OCR-detected zones
  classification String?        // JSON: AI classification of which part/rooms this diagram covers
  uploadedAt     DateTime       @default(now())

  // ── Revision chain (DPR PRD §3.2 G10 / transcript R4) ──
  parentId       String?        // null on the base drawing; else the family root
  parent         Drawing?       @relation("DrawingRevisions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions      Drawing[]      @relation("DrawingRevisions")
  revisionNotes  String?        // what changed in this revision
  isFinal        Boolean        @default(false) // the approved drawing calculations derive from
  finalisedAt    DateTime?
  finalisedById  String?
  // PUF_PANEL | REFRIGERATION | DOOR | ELECTRICAL | CUSTOM — ties the family to a
  // row of Project.drawingApprovals (see services/drawingApprovals.ts).
  discipline     String?

  zones          ProjectZone[]

  @@index([projectId])
  @@index([parentId])
}

model ProjectZone {
  id          String    @id @default(cuid()) @map("_id")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingId   String?
  drawing     Drawing?  @relation(fields: [drawingId], references: [id])

  zoneName    String
  boqCategory String?
  roomType    String?
  coordinates String?   // JSON polygon: [{x,y}, ...] in 0..100 floor-plan space
  heightM     Float?    // for 3D extrusion
  temperatureRange String? // e.g. "-30C", "1-3C" (Room-wise tracking)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  // ── Room-wise DPR (Room_Handover tab) ──
  // `isCommonBucket` marks the single pseudo-room that holds plant-wide
  // Refrigeration/Electrical work — the sheet's "Common / Plant-wide" dropdown
  // value. It has no geometry and never appears on the handover tracker.
  isCommonBucket      Boolean   @default(false)
  plannedHandoverDate DateTime?
  // Recorded by an explicit sign-off, NEVER derived. The sheet computes this as
  // MAXIFS(lastUpdated WHERE status="Completed"), which reports Ambient as
  // "handed over 3 days early" while the room is 30% built (PRD §4 bug B3).
  actualHandoverDate  DateTime?
  handoverById        String?
  handoverCertUrl     String?

  boqItems    BOQItem[]
  ganttActivities GanttActivity[]
  scopeItems  RoomScopeItem[]

  @@index([projectId])
}

// ── Room-wise DPR ────────────────────────────────────────────────────────────
// A faithful, DB-backed replacement for DPR_Cold_Storage_RoomWise.xlsx.
// See lib/dprCatalog.ts for the activity catalogue and services/dprRollup.ts for
// the calculation chain (which reproduces the sheet's formulas exactly, and also
// offers a corrected mode — PRD §4).

// One row per (room × category × activity) — the 118 rows of the room sheets.
// `zoneId` = null is not allowed; the Common / Plant-wide bucket is a real
// ProjectZone with isCommonBucket = true, so the unique index stays simple.
model RoomScopeItem {
  id              String   @id @default(cuid()) @map("_id")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zoneId          String
  zone            ProjectZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  category        String    // PUF Panel | Door Work | Floor & Racking | Refrigeration | Electrical
  activity        String    // from ROOM_ACTIVITIES / COMMON_ACTIVITIES
  uom             String    // owned here — never typed on the daily entry (bug B5)

  // The drawing team's room-wise breakup of the BOQ quantity. Null = "not yet
  // broken up". The sheet leaves this blank, which makes % blank, which makes
  // AVERAGE() skip the row — the 89% illusion (bug B1). We count null as 0%.
  targetQty       Float?
  targetSource    String?   // DRAWING | BOQ_SPLIT | MANUAL
  weight          Float    @default(1)   // rollup weight, corrected mode (bug B2)

  plannedStart    DateTime?
  plannedFinish   DateTime?
  plannedHandover DateTime?

  // Reconciliation link: Σ(targetQty) across rooms should equal BOQItem.plannedQty.
  boqItemId       String?
  boqItem         BOQItem? @relation(fields: [boqItemId], references: [id])

  sortOrder       Int      @default(0)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries         DPREntry[]

  @@unique([projectId, zoneId, activity])
  @@index([projectId])
  @@index([boqItemId])
}

// The Daily_Entry tab: one shared log for the whole project, one row per
// activity done today. Deliberately a separate table from ProgressEntry —
// ProgressEntry records progress against a *project-wide BOQ line*, whereas this
// records it against a *room × activity*. They are different granularities and
// merging them now would break calc.ts / boqCost.ts. The bridge is
// RoomScopeItem.boqItemId (see PRD §5.1).
//
// `qtyDoneToday` is TODAY'S quantity, not cumulative — the cumulative figure is
// always SUM(qtyDoneToday) over approved entries, exactly like the sheet's SUMIFS.
//
// `kind` exists because in the real workbook people type straight over the
// SUMIFS formula: 'Ambient Room'!I8 reads 200 with no formula at all, while the
// Daily_Entry log only accounts for 55 (PRD §4 bug B11). That override is a
// legitimate need — a cumulative figure known from the site that was never
// logged day-by-day — but destroying the formula makes it unauditable.
// An ADJUSTMENT/OPENING entry gives the same result with a who, a when and a why.
//   DAILY      — normal day's work
//   OPENING    — cumulative carried in from before the app was used
//   ADJUSTMENT — a correction to the running total (reason mandatory)
model DPREntry {
  id              String   @id @default(cuid()) @map("_id")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomScopeItemId String
  roomScopeItem   RoomScopeItem @relation(fields: [roomScopeItemId], references: [id], onDelete: Cascade)

  kind            String   @default("DAILY")  // DAILY | OPENING | ADJUSTMENT
  date            DateTime
  qtyDoneToday    Float                       // may be negative on an ADJUSTMENT
  labourTeam      String?   // sheet column G — "Team A", "Rehman"
  remarks         String?
  photoUrl        String?

  submittedById   String
  status          String   @default("APPROVED")  // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([roomScopeItemId])
  @@index([date])
}

// The Milestones tab. `fkiFreezeDate` is a real date — the sheet stores "7th",
// "10th" as text, which is why its Delay formula ignores it (bug B8).
model ProjectMilestone {
  id                  String   @id @default(cuid()) @map("_id")
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String   // "Ambient" | "Refrigeration Piping Completion" | "Final Handover (HO)"
  zoneId              String?  // set when the milestone IS a room
  committedDateVendor DateTime?
  fkiFreezeDate       DateTime?
  actualDate          DateTime?
  remarks             String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}

// ── Audit ────────────────────────────────────────────────────────────────────

// ── BOQ Enhancements + Gantt + Room Tracking (PRD v1.0) ─────────────────────

// Master list of equipment make/model options for BOQ equipment items.
model MachineModel {
  id              String   @id @default(cuid()) @map("_id")
  make            String   // Bitzer, Copeland, Danfoss, Daikin, Haier
  modelCode       String   // S6F-30.2Y-40P, ZB76, etc.
  fullDisplayName String?  // "Bitzer — S6F-30.2Y-40P (27 kW, R404A)"
  capacityKW      Float?
  refrigerantType String?  // R404A, R134a, R407C, R448A
  compressorType  String?  // Semi-hermetic, Scroll, VFD
  applicableRooms String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Price & datasheet (BOQ & Budget PRD v1 §6b) ──
  // The reference (list) price for this model, and its technical datasheet (TDS),
  // so picking the model surfaces "what this costs / what we paid last time".
  unitPrice       Float?
  tdsUrl          String?   // Technical Data Sheet / spec PDF (uploaded file OR a link)

  // ── TDS auto-extraction (Machine-Model/TDS PRD §1–§4) ──
  // Filled from the uploaded TDS. IDU and ODU sheets use different labels for the
  // same thing (Evaporator Temp vs Evaporating SST), normalised on the way in.
  // `specs` is the full extracted key/value map so nothing is lost as new datasheet
  // formats appear; the columns below are the fields used for machine selection.
  tdsFormat       String?   // IDU | ODU | OTHER — detected from the sheet
  evaporatorTempC Float?
  condenserTempC  Float?
  ambientTempC    Float?
  airflow         String?   // "21465 m3/h" / "24327 CMH" (unit kept as printed)
  finSpacing      String?   // "7 MM"
  fanDetail       String?   // "500 mm X 3" / "Axial Fans Ø500 X 4"
  powerInputKw    Float?
  weightKg        Float?
  dimensions      String?   // "L x W x H"
  voltage         String?   // "415V/3PH"
  compressorModel String?   // "HGX56e/995-4L (Bock)" — distinct from compressorType
  specs           Json?     // every field read off the TDS, incl. ones not columnised

  boqItems        BOQItem[]
}

// Vendor sub-item breakdown for a BOQ category, validated against planned qty.
// ── Frozen budget line (BOQ & Budget PRD v1 §3) ───────────────────────────────
// One per BOQ item: what we ESTIMATED this line would cost when the bid was
// costed. Every PO raised against the item is later measured against this.
//
// Deliberately separate from BOQCostAnnotation (which records what a PO ACTUALLY
// cost): the budget must survive untouched even as the actuals move around it.
// It is frozen at the project level (Project.budgetStatus) — see routes/budget.ts.
model BOQBudgetLine {
  id           String   @id @default(cuid()) @map("_id")
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // One budget line per BOQ item — the granularity the PO is compared at.
  boqItemId    String   @unique
  boqItem      BOQItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  // Defaults to the BOQ's plannedQty, but the costing may assume a different
  // quantity (e.g. wastage), so it is its own number.
  budgetQty    Float?
  budgetRate   Float?   // per unit — the internal estimate
  budgetAmount Float?   // qty × rate, stored so the number that was frozen is the number kept
  notes        String?  // why this rate — the basis of the estimate

  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

// ── Vendor quotation (BOQ & Budget PRD v1 §4) ─────────────────────────────────
// A price a vendor quoted for one BOQ item. Three (or more) are compared side by
// side; the cheapest is marked L1 but is NOT automatically the winner — delivery,
// quality and payment terms matter, so the award records the chosen vendor AND a
// reason (mandatory when the pick is not L1).
//
// Revisions: a re-quote after negotiation supersedes the previous one. The old
// row is kept (status SUPERSEDED, linked by parentId) so the history is never lost.
model VendorQuotation {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId     String
  boqItem       BOQItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  vendorName    String

  price         Float                       // the quoted price for this item
  deliveryDate  DateTime?
  deliveryWeeks Int?                        // delivery lead time in WEEKS (§6.2 — primary)
  leadTimeText  String?                     // free text when there is no firm date
  paymentTerms  String?                     // dropdown preset OR typed (§6.1)
  qualityRemarks String?
  modelNumber   String?                     // the vendor's own model number for this item (§6)
  tdsUrl        String?                     // the vendor's TDS for their quote (§6.3)
  quotationPdfUrl String?                   // the supporting quotation document

  // Revision chain — a re-quote points back to the one it replaces.
  revision      Int      @default(1)
  parentId      String?
  status        String   @default("ACTIVE") // ACTIVE | SUPERSEDED | AWARDED

  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([boqItemId])
}

model BOQItemList {
  id              String   @id @default(cuid()) @map("_id")
  boqItemId       String
  boqItem         BOQItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  items           Json     // [{itemCode, description, unit, qty}]
  totalQty        Float    @default(0)
  matchesBoqQty   Boolean  @default(false)
  toleranceUsed   Float    @default(10)   // % tolerance
  overrideNote    String?                 // justification when outside tolerance
  uploadedFileUrl String?
  uploadedById    String?
  uploadedAt      DateTime @default(now())

  @@index([boqItemId])
}

// Gantt timeline activity. status: NOT_STARTED | IN_PROGRESS | COMPLETED | DELAYED
//
// Plan vs actual (Sprint PRD §3): delay is only meaningful once actual dates are
// captured. `plannedDurationDays` IS the activity's TAT (working days) — it is
// the value shown on the bar tooltip; there is no separate `tatDays` column.
model GanttActivity {
  id                  String   @id @default(cuid()) @map("_id")
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityName        String
  boqItemId           String?
  boqItem             BOQItem? @relation(fields: [boqItemId], references: [id])
  zoneId              String?
  zone                ProjectZone? @relation(fields: [zoneId], references: [id])
  plannedStartDate    DateTime
  plannedDurationDays Int      @default(1)   // TAT in working days
  plannedEndDate      DateTime
  actualStartDate     DateTime?              // set by "Mark Started"
  actualEndDate       DateTime?              // set by "Mark Complete" — clears the delay
  completedAt         DateTime?              // immutable stamp of WHEN completion was recorded
  completedById       String?                // who recorded it
  completionNotes     String?
  // Running progress-remarks log for this activity: how far the work has reached
  // after "Mark Started", why it is late, etc. Each entry is timestamped and
  // attributed. JSON array of { at, byId, byName, byEmail, text }.
  remarks             String?
  responsibleUserId   String?                // project user accountable for this activity
  responsibleName     String?                // free-text fallback (e.g. "Kingspan", "Site Engineer")
  percentComplete     Float    @default(0)
  percentCompleteAuto Boolean  @default(true) // true = pull from BOQ progress
  status              String   @default("NOT_STARTED")
  dependencies        String[] @default([])   // predecessor GanttActivity ids
  assignedVendor      String?
  sequence            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}

// Change Order. type: QTY_INCREASE | QTY_DECREASE | NEW_ITEM | SUBSTITUTION
// status: DRAFT | PENDING | APPROVED | REJECTED (reuses the PO/WO approval pattern)
model ChangeOrder {
  id              String   @id @default(cuid()) @map("_id")
  coNumber        String   @unique
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId       String?
  boqItem         BOQItem? @relation(fields: [boqItemId], references: [id])
  type            String
  description     String
  originalQty     Float?
  changeQty       Float    @default(0)
  newTotalQty     Float?
  unit            String?
  costImpact      Float?
  paidByClient    String?  // YES | NO | TBD
  justification   String?
  status          String   @default("DRAFT")
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  history         Json?    // baseline-change audit trail
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

// ── Sequential approval chain (PO / WO / GRN) ────────────────────────────────
// Polymorphic by (docType, docId). One row per approver in the chain, ordered
// by `order`. The current step = lowest-order row with status PENDING.
// status: WAITING (not yet its turn) | PENDING (awaiting this approver) |
//         APPROVED | REJECTED
model ApprovalStep {
  id            String    @id @default(cuid()) @map("_id")
  docType       String    // PO | WO | GRN
  docId         String
  projectId     String
  order         Int
  approverId    String
  approverName  String
  approverEmail String?
  approverRole  String?
  status        String    @default("WAITING")
  actedAt       DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  // When the current pending approver was last auto-reminded. Drives the 24-hour
  // reminder cadence so no one is nudged more than once per window.
  lastRemindedAt DateTime?

  @@index([docType, docId])
}

// ── Value-threshold approval matrix (DPR PRD §3.2 G6 / transcript R13) ───────
// "Kitne ka PO kaun approve karega? Amit 10,000 ka approve karega, Manish utna
//  karega, phir finance involve hoyega."
//
// One row per (docType, amount band, approver). The chain for a document of
// value V is every ACTIVE rule of that docType whose band contains V, ordered by
// `order`. `maxAmount = null` means "no upper bound" — the final approver.
//
// `projectId = null` is the org-wide default; a project-specific rule set, when
// present, replaces the defaults for that project entirely.
// Fixed, admin-configured approval chain per document type (PO | WO | GRN |
// PAYMENT). Configure once in Users → Approval Chain; every future document of
// that type is routed through it automatically, in `order`, with no per-submit
// picking. The value-band ApprovalRule matrix still decides WHETHER a document
// needs approval / who is mandatory; this decides WHO signs and in what order.
model ApprovalChainConfig {
  id           String   @id @default(cuid()) @map("_id")
  docType      String   // PO | WO | GRN | PAYMENT
  projectId    String?  // null = company-wide default; set = project override
  approverId   String
  approverName String
  approverRole String?
  order        Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([docType, projectId])
}

model ApprovalRule {
  id           String   @id @default(cuid()) @map("_id")
  projectId    String?
  docType      String            // PO | WO | GRN
  minAmount    Float    @default(0)   // rule applies when docValue >= minAmount
  maxAmount    Float?            // ...and (maxAmount == null || docValue <= maxAmount)
  approverId   String
  approverName String
  approverRole String?
  order        Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([docType, projectId])
}

// Immutable log of every approval-workflow action for the timeline / audit.
// action: SUBMITTED | APPROVED | REJECTED | REMINDED
model ApprovalAction {
  id         String   @id @default(cuid()) @map("_id")
  docType    String
  docId      String
  stepId     String?
  actorId    String?
  actorName  String
  actorEmail String?
  actorRole  String?
  action     String
  remarks    String?
  at         DateTime @default(now())

  @@index([docType, docId])
}

// LEGACY durable file store — a single Bytes column, capped at Mongo's 16MB
// per-document limit (so big DXF drawings never fit). Superseded by GridFS
// (bucket "uploads", see lib/fileStore.ts), which chunks files and handles any
// size. Kept only so the handful of files saved here before the switch stay
// readable; `streamFromDb` falls back to it after GridFS. New writes never land
// here.
model StoredFile {
  id        String   @id @default(cuid()) @map("_id")
  filename  String   @unique
  mimeType  String?
  size      Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())
}

// In-app notifications (Module C). Email is a future add-on.
model Notification {
  id                  String   @id @default(cuid()) @map("_id")
  userId              String                 // recipient
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                String                 // e.g. PO_SUBMITTED, PO_APPROVED, GRN_APPROVED, MILESTONE_TRIGGERED
  title               String
  message             String
  projectId           String?
  relatedDocType      String?                // ProcurementDoc | GRN | PaymentMilestone
  relatedDocId        String?
  link                String?                // optional client route hint
  isRead              Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "PROJECT_CREATE", "BOQ_LOCK", "ENTRY_APPROVE"
  entity    String?  // entity type
  entityId  String?
  details   String?  // JSON metadata
  createdAt DateTime @default(now())

  @@index([projectId])
  // The per-user activity view reads this trail by user, newest first.
  @@index([userId])
}

// ── API key (Integration Kit) ─────────────────────────────────────────────────
// An admin-issued key that lets an external system read CRMCTS data through the
// public /api/v1 endpoints. The raw key is shown ONCE at creation and never
// stored — only its SHA-256 hash is kept, so a leaked DB reveals no usable keys.
// `prefix` is the first few visible characters, so a key can be identified and
// revoked without ever seeing the secret again.
model ApiKey {
  id          String    @id @default(cuid()) @map("_id")
  name        String
  keyHash     String    @unique
  prefix      String
  mode        String    @default("live")          // live | test
  // Which data domains the key may reach (see lib/apiScopes REALMS).
  realms      String[]  @default([])
  // Which sensitive fields come back (see lib/apiScopes SCOPES). read:core is always on.
  scopes      String[]  @default(["read:core"])
  rateLimitPerMin Int   @default(600)
  ipAllowlist String[]  @default([])               // empty = any IP
  expiresAt   DateTime?                             // null = never expires
  active        Boolean   @default(true)
  revokedAt     DateTime?
  revokedByName String?                            // who revoked it (provenance)
  rotatedAt     DateTime?                          // last time the secret was rotated
  callCount     Int       @default(0)              // lifetime successful calls
  createdById   String?
  createdByName String?                            // who minted it (provenance)
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
}

// Idempotency store for key-authenticated writes: a repeated Idempotency-Key
// from the same key returns the first result instead of acting twice.
model ApiIdempotencyRecord {
  id       String   @id @default(cuid()) @map("_id")
  keyId    String
  idemKey  String
  status   Int
  response Json
  at       DateTime @default(now())

  @@unique([keyId, idemKey])
  @@index([keyId])
}

// Per-day call tally for a key — cheap lifetime aggregate. One row per key/day.
model ApiKeyUsage {
  id     String @id @default(cuid()) @map("_id")
  keyId  String
  day    String                                     // YYYY-MM-DD (UTC)
  count  Int    @default(0)

  @@unique([keyId, day])
  @@index([keyId])
}

// Per-request audit log — powers the "Usage" detail (route, status, latency, IP).
// Trimmed to a rolling window so it stays bounded.
model ApiKeyCall {
  id     String   @id @default(cuid()) @map("_id")
  keyId  String
  method String
  route  String
  status Int
  ms     Int
  ip     String
  at     DateTime @default(now())

  @@index([keyId, at])
}

// ── Petty Cash (site-manager float) ──────────────────────────────────────────
// A custodian (the site manager) holds a cash float that Accounts tops up, and
// records expenses against it. Each expense flows: RECORDED → SUBMITTED (to
// Accounts) → CONFIRMED / REJECTED (sent back to correct). A TOPUP just adds to
// the float. Company-wide by default; an entry may be tagged to a project so the
// same ledger can also be viewed per project.
model PettyCashEntry {
  id             String    @id @default(cuid()) @map("_id")
  entryNumber    String    @unique              // PETTY-#####
  type           String    @default("EXPENSE")  // EXPENSE | TOPUP
  date           DateTime  @default(now())

  // Expense fields
  category       String?                         // ledger head / expense category
  amount         Float     @default(0)           // always positive; `type` gives the sign
  technician     String?                         // "for whom"
  paidTo         String?                         // vendor / person
  projectId      String?                         // optional project tag
  jobOrder       String?                         // free-text JO / client
  description    String?

  // Top-up fields
  reason         String?                         // top-up reason (e.g. "Float")
  utrNumber      String?                         // top-up bank ref

  // Files (expense): supporting invoice, budget-approval copy, payment screenshot
  invoiceUrl     String?
  budgetUrl      String?
  paymentUrl     String?
  // Any number of extra documents added later via the "+" — JSON array of
  // { kind, fileName, fileUrl, at }. The three fields above seed it on create.
  documents      String?

  // Lifecycle
  status         String    @default("RECORDED")  // RECORDED | SUBMITTED | CONFIRMED | REJECTED | VOID
  sanctionedAmount Float?                         // Accounts may sanction a different amount
  decisionRemark String?
  decidedBy      String?
  decidedAt      DateTime?

  custodianName  String?
  custodianEmail String?
  recordedById   String?
  recordedByName String?

  // Append-only JSON arrays: trail = [{ at, action, byName, remark }],
  // comments = [{ at, byName, text }].
  trail          String?
  comments       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type, status])
  @@index([projectId])
}

// Who holds the float. projectId null = the company-wide custodian; a row with a
// projectId set overrides it for that project.
model PettyCashConfig {
  id             String    @id @default(cuid()) @map("_id")
  projectId      String?                         // null = company-wide
  custodianName  String?
  custodianEmail String?
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
}
